.venv/
__pycache__/
*.egg-info/
.DS_Store
MUJOCO_LOG.TXT
docs/robotis/
# Loose reference material (datasheets, PDFs) dropped in while working.
docs/scratch/
runs/
traces/
bench/logs/archive/
# Loose output dropped BESIDE an analysis script is scratch and stays out;
# figures worth keeping go in analysis/<category>/plots/, which docs/ links
# point at. This works because a gitignore `*` does not cross `/`, so these
# patterns match only files directly in analysis/ or directly in a category
# folder (analysis/policy/x.png), and never analysis/<category>/plots/*.png --
# no negation rule needed. Do not "tidy" them to analysis/** without adding
# one, or the tracked figures silently disappear from the index.
# (analysis/contact/wheel_slowmo.py writes clips to traces/ by default; they were
# briefly tracked here at ~7 MB each, which is what these rules came from.)
analysis/*.png
analysis/*.mp4
analysis/*.html
analysis/*/*.png
analysis/*/*.mp4
analysis/*/*.html
# Raw TM151 captures (analysis/sensing/tm151_record.py). Instrument data, not results:
# megabytes per capture, superseded by the next one, and the CONCLUSIONS go in
# the plan doc. Keep a capture worth citing by moving it out of here by hand.
analysis/recordings/
# GPU pod runs (analysis/gpu/phaseN/results_*/, docs/plans/gpu-training.md):
# what comes back from a pod but is not a result. Done markers; step logs that
# are empty on success (pip, the cache tar, the detached launch); the Warp
# kernel cache (8.8 MB, compiled for one GPU arch -- keep the newest by hand
# for the next pod); the built PufferLib binary (1.7 MB, one arch); policy
# checkpoints (.bin, ~200 KB each: convert with gpu/export_policy.py, and
# Dropbox still keeps them). Named, not `results*/**`, so a new kind of output
# shows up in `git status` instead of vanishing.
analysis/gpu/*/results*/DONE
analysis/gpu/*/results*/ALL_DONE
analysis/gpu/*/results*/pip_phase*.log
analysis/gpu/*/results*/warp_cache.log
analysis/gpu/*/results*/launch.log
analysis/gpu/*/results*/warp-cache.tgz
analysis/gpu/*/results*/*/warp-cache.tgz
# the merged Warp kernel cache a pod is seeded with (one per GPU arch, in one file)
analysis/gpu/warp-cache.tgz
analysis/gpu/*/results*/puffer
analysis/gpu/*/results*/**/*.bin
# Phase 1's inputs, regenerated by the export recipe in the plan doc.
analysis/gpu/phase1/v3_rigid.mjb
analysis/gpu/phase1/v3_init_state.npz
# Regenerated by `python -m aow_sim.export_deploy`, and pinned to a params
# digest that hw.state checks on load -- a stale one raises rather than
# silently flying the wrong gains.
deploy/
# Personal working agreements for agents in this checkout; not a team document.
CLAUDE.md
.claude/

# scripts/site.sh build: the assembled static site, rebuilt from tracked sources.
site/build/
# wrangler (scripts/site.sh deploy) keeps its local state here.
.wrangler/
