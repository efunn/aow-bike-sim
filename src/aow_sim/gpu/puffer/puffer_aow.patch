+
+#ifdef AOW_NORM_ADV
+// SB3's normalize_advantage: per minibatch, (A - mean) / (std + 1e-8), in
+// place, after puff_advantage (returns are already written). One block.
+constexpr int AOW_NORM_THREADS = 1024;
+__global__ void aow_norm_adv(precision_t* adv, int n) {
+    __shared__ float s1[AOW_NORM_THREADS], s2[AOW_NORM_THREADS];
+    int tid = threadIdx.x;
+    float a = 0.0f, b = 0.0f;
+    for (int i = tid; i < n; i += AOW_NORM_THREADS) {
+        float v = to_float(adv[i]);
+        a += v;
+        b += v * v;
+    }
+    s1[tid] = a;
+    s2[tid] = b;
+    __syncthreads();
+    for (int s = AOW_NORM_THREADS / 2; s > 0; s >>= 1) {
+        if (tid < s) {
+            s1[tid] += s1[tid + s];
+            s2[tid] += s2[tid + s];
+        }
+        __syncthreads();
+    }
+    float mean = s1[0] / float(n);
+    float var = fmaxf(s2[0] / float(n) - mean * mean, 0.0f);
+    float inv = 1.0f / (sqrtf(var) + 1e-8f);
+    for (int i = tid; i < n; i += AOW_NORM_THREADS) {
+        adv[i] = from_float((to_float(adv[i]) - mean) * inv);
+    }
+}
+#endif
+
+#ifdef AOW_GRAD_LOG
+// Gradient norms on the policy MEAN (d loss / d mu, summed over an epoch's
+// minibatches): [0] PPO's clipped surrogate, [1] the temporal term. One
+// line per epoch: "AOW_GRAD pg <rms> smooth <rms> ratio <smooth/pg>".
+// SmoothPPO's weights were chosen in PARAMETER space (policy-smoothness-
+// losses.md §4: the term at ~1/4 of PPO's actor gradient), so this ratio
+// is the same idea measured at the network's output, not the same number.
+__device__ float aow_gn[2];
+__global__ void aow_grad_report() {
+    float pg = sqrtf(aow_gn[0]), sm = sqrtf(aow_gn[1]);
+    printf("AOW_GRAD pg %.4e smooth %.4e ratio %.4f\n", pg, sm, pg > 0.0f ? sm / pg : 0.0f);
+    aow_gn[0] = 0.0f;
+    aow_gn[1] = 0.0f;
+}
+#endif
