 constexpr int PPO_THREADS = 256;
 
+// AoW bike: SmoothPPO's temporal term on the policy mean, switched on by the
+// env file (aow_bike.cu: #define AOW_SMOOTH_TEMPORAL <lambda>). Continuous only.
+#ifdef AOW_SMOOTH_TEMPORAL
+#include "smooth_temporal.h"
